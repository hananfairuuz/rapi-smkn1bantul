APP_NAME="RAPI-Sekolah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rapi-smkn1bantul.web.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=GANTI_NAMA_DATABASE_CPANEL
DB_USERNAME=GANTI_USER_DATABASE_CPANEL
DB_PASSWORD=GANTI_PASSWORD_DATABASE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=rapi-smkn1bantul.web.id
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=GANTI_HOST_SMTP
MAIL_PORT=587
MAIL_USERNAME=GANTI_EMAIL_SMTP
MAIL_PASSWORD=GANTI_PASSWORD_EMAIL
MAIL_FROM_ADDRESS=GANTI_EMAIL_PENGIRIM
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"

# CI/CD Deployment Webhook Secret (Wajib diisi dengan string acak untuk keamanan CI/CD FTPS)
DEPLOY_SECRET_KEY=GANTI_DENGAN_TOKEN_RAHASIA_MINIMAL_32_KARAKTER
